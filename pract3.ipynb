import os
import random
import json
import numpy as np
import matplotlib.pyplot as plt
import torch
import torchvision.models as models
from torchvision import transforms
from PIL import Image

# ---------------------------------------------------------------
# Setup: Load pre-trained VGG16
# ---------------------------------------------------------------
print("Loading pre-trained VGG16 ...")
model = models.vgg16(weights=models.VGG16_Weights.IMAGENET1K_V1)
model.eval()
print("Model ready.\n")

# Standard preprocessing for VGG16
# (ImageNet mean/std normalisation, resize to 224×224)
preprocess = transforms.Compose([
    transforms.Resize((224, 224)),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485, 0.456, 0.406],
                         std =[0.229, 0.224, 0.225])
])

# Load ImageNet class names (1000 classes)
# Download from: https://raw.githubusercontent.com/anishathalye/imagenet-simple-labels/master/imagenet-simple-labels.json
try:
    with open("imagenet_labels.json", "r") as f:
        IMAGENET_LABELS = json.load(f)   # list of 1000 class names
    print("ImageNet labels loaded.")
except:
    # Fallback: just use class index if file not found
    IMAGENET_LABELS = [str(i) for i in range(1000)]
    print("imagenet_labels.json not found – using index numbers.\n"
          "Download from: https://raw.githubusercontent.com/anishathalye/imagenet-simple-labels/master/imagenet-simple-labels.json")


# ---------------------------------------------------------------
# Helper: Predict ImageNet class for one image
# ---------------------------------------------------------------

def predict_imagenet(image_path, top_k=3):
    """
    Given an image path, returns the top-k ImageNet predictions.
    Returns: list of (class_name, probability) tuples
    """
    img = Image.open(image_path).convert("RGB")
    tensor = preprocess(img).unsqueeze(0)   # shape: (1, 3, 224, 224)

    with torch.no_grad():
        output = model(tensor)              # raw scores (logits)

    probabilities = torch.softmax(output[0], dim=0)   # convert to probabilities
    top_probs, top_indices = torch.topk(probabilities, top_k)

    results = []
    for prob, idx in zip(top_probs, top_indices):
        class_name = IMAGENET_LABELS[idx.item()]
        results.append((class_name, prob.item()))
    return results


# ---------------------------------------------------------------
# TASK 1: Predict ImageNet class for 1 image from each of 8 CUB classes
# ---------------------------------------------------------------

def task1_predict_cub_images(cub_images_dir, num_classes=8):
    """
    Picks 1 image from each of 8 random CUB-200 classes,
    predicts ImageNet class, and shows visual comparison.

    cub_images_dir: path to CUB_200_2011/images/ folder
    Structure: images/<class_folder>/<image>.jpg
    """
    # Get all class folders
    all_classes = sorted(os.listdir(cub_images_dir))
    all_classes = [c for c in all_classes if os.path.isdir(
                   os.path.join(cub_images_dir, c))]

    # Randomly select 8 classes
    selected_classes = random.sample(all_classes, num_classes)
    print(f"Selected {num_classes} CUB classes:")
    for c in selected_classes:
        print(f"  {c}")

    # For each class, pick 1 random image and predict
    results = []
    for class_name in selected_classes:
        class_folder = os.path.join(cub_images_dir, class_name)
        images = [f for f in os.listdir(class_folder) if f.endswith(".jpg")]
        chosen_image = random.choice(images)
        image_path = os.path.join(class_folder, chosen_image)

        predictions = predict_imagenet(image_path, top_k=1)
        imagenet_class = predictions[0][0]
        confidence = predictions[0][1]

        results.append({
            "cub_class"    : class_name,
            "image_path"   : image_path,
            "imagenet_class": imagenet_class,
            "confidence"   : confidence
        })

    # --- Display results as a grid ---
    fig, axes = plt.subplots(2, 4, figsize=(20, 10))
    axes = axes.flatten()
    fig.suptitle("CUB-200 Images: CUB Class vs VGG16 ImageNet Prediction",
                 fontsize=14, fontweight="bold")

    for i, r in enumerate(results):
        img = Image.open(r["image_path"]).convert("RGB")
        axes[i].imshow(img)
        axes[i].set_title(
            f"CUB: {r['cub_class'].split('.')[1][:20]}\n"          # CUB class (short)
            f"ImageNet: {r['imagenet_class']}\n"                   # predicted class
            f"Confidence: {r['confidence']*100:.1f}%",
            fontsize=8
        )
        axes[i].axis("off")

    plt.tight_layout()
    plt.savefig("Lab3_CUB_vs_ImageNet_Predictions.png", dpi=150)
    plt.show()
    print("\nPrediction plot saved.")

    # --- Print text comparison ---
    print("\n--- Visual Comparison Summary ---")
    print(f"{'CUB Class':<40} {'ImageNet Prediction':<30} {'Confidence':>10}")
    print("-" * 85)
    for r in results:
        cub_short = r["cub_class"].split(".")[-1][:38]
        print(f"{cub_short:<40} {r['imagenet_class']:<30} {r['confidence']*100:>9.1f}%")

    print("\nComment:")
    print("  - VGG16 was trained on ImageNet, which has some bird classes (e.g. jay, robin).")
    print("  - For common birds, predictions may be close or same.")
    print("  - For rare species (CUB has 200 fine-grained bird types),")
    print("    ImageNet predicts a broader/generic bird category.")
    print("  - This shows the limitation of using a general model for fine-grained tasks.")

    return results


# ---------------------------------------------------------------
# TASK 2: Reconfigure VGG16 last layer for N custom classes
# ---------------------------------------------------------------

def task2_reconfigure_vgg16(num_classes=200):
    """
    Replaces the last fully-connected layer of VGG16 so it outputs
    'num_classes' predictions instead of 1000 (ImageNet default).

    This is called Transfer Learning / Fine-tuning.
    Use num_classes=200 for CUB-200-2011, or any other number.
    """
    print(f"\n--- Reconfiguring VGG16 for {num_classes} classes ---")

    # Load fresh VGG16
    custom_model = models.vgg16(weights=models.VGG16_Weights.IMAGENET1K_V1)

    # --- Step 1: Freeze all layers (don't retrain conv layers) ---
    # This preserves the learned ImageNet features
    for param in custom_model.parameters():
        param.requires_grad = False

    # --- Step 2: Replace last classifier layer ---
    # Original last layer: Linear(4096 → 1000)  (1000 ImageNet classes)
    # New last layer:      Linear(4096 → num_classes)
    print("\nOriginal Classifier:")
    print(custom_model.classifier)

    # Get number of input features of the last layer
    in_features = custom_model.classifier[6].in_features  # 4096

    # Replace layer index 6 (the last Linear layer)
    custom_model.classifier[6] = torch.nn.Linear(in_features, num_classes)
    # Only this new layer will be trained (requires_grad=True by default for new layers)

    print(f"\nModified Classifier (last layer now outputs {num_classes}):")
    print(custom_model.classifier)

    # --- Step 3: Verify parameter counts ---
    total      = sum(p.numel() for p in custom_model.parameters())
    trainable  = sum(p.numel() for p in custom_model.parameters() if p.requires_grad)
    frozen     = total - trainable

    print(f"\nTotal parameters      : {total:,}")
    print(f"Trainable parameters  : {trainable:,}  (only the new last layer)")
    print(f"Frozen parameters     : {frozen:,}   (all conv layers, kept from ImageNet)")

    # --- Step 4: Test forward pass with dummy input ---
    dummy_input = torch.randn(1, 3, 224, 224)   # fake image batch of 1
    with torch.no_grad():
        output = custom_model(dummy_input)
    print(f"\nTest forward pass output shape: {output.shape}")
    print(f"Expected: (1, {num_classes}) ✓" if output.shape[1] == num_classes else "Shape mismatch!")

    print("\nModel is ready for fine-tuning on your dataset.")
    print("Next steps:")
    print("  1. Create a DataLoader for your dataset (CUB-200 or custom)")
    print("  2. Use CrossEntropyLoss as the loss function")
    print("  3. Use Adam or SGD optimizer on trainable params only")
    print("  4. Train for several epochs and monitor accuracy")

    return custom_model


# ---------------------------------------------------------------
# BONUS: Simple training loop template (for reference)
# ---------------------------------------------------------------

def training_loop_template(model, train_loader, num_epochs=5):
    """
    Template for fine-tuning the reconfigured model.
    (Needs a DataLoader to run — shown here as a guide)
    """
    import torch.optim as optim

    # Loss function: cross-entropy is standard for classification
    criterion = torch.nn.CrossEntropyLoss()

    # Optimizer: only train the new last layer (frozen layers excluded)
    optimizer = optim.Adam(
        filter(lambda p: p.requires_grad, model.parameters()),
        lr=0.001
    )

    for epoch in range(num_epochs):
        model.train()   # enable training mode
        total_loss = 0

        for images, labels in train_loader:
            optimizer.zero_grad()          # clear old gradients
            outputs = model(images)        # forward pass
            loss = criterion(outputs, labels)  # compute loss
            loss.backward()                # backprop
            optimizer.step()               # update weights
            total_loss += loss.item()

        avg_loss = total_loss / len(train_loader)
        print(f"Epoch [{epoch+1}/{num_epochs}]  Loss: {avg_loss:.4f}")

    print("Training complete!")
    return model


