# ---------------------------------------------------------------
# TASK (iii): Classify filters as High Pass or Low Pass
# ---------------------------------------------------------------

def classify_filter(conv_layer, filter_indices):
    """
    Classifies each filter as High Pass or Low Pass.
    Logic:
      - Low Pass filter: positive, similar weights → smoothing/blurring
      - High Pass filter: mix of positive and negative weights → edge detection
    """
    weights = conv_layer.weight.data.cpu().numpy()
    print("\n--- Filter Classification (High Pass / Low Pass) ---")

    for idx in filter_indices:
        filt = weights[idx].mean(axis=0)   # average across input channels
        pos  = np.sum(filt > 0)
        neg  = np.sum(filt < 0)
        std  = np.std(filt)

        # High variation / negative values → High Pass (detects edges)
        # Low variation / all positive → Low Pass (smooths/blurs)
        if std > 0.1 or neg > 2:
            label = "HIGH PASS (Edge Detector)"
        else:
            label = "LOW PASS  (Smoothing)"

        print(f"  Filter {idx:3d}: std={std:.4f}, pos={pos}, neg={neg} → {label}")

classify_filter(conv_layers[0], selected_filter_indices)


# ---------------------------------------------------------------
# TASK (iv): Frequency Response of selected filters
# ---------------------------------------------------------------

def display_frequency_response(conv_layer, filter_indices, layer_name="Stack1_Conv1"):
    """
    Uses 2D FFT to compute and display the frequency response
    of each selected filter.
    - Low pass filters → energy concentrated in the center (low frequencies)
    - High pass filters → energy at the edges (high frequencies)
    """
    weights = conv_layer.weight.data.cpu().numpy()
    n = len(filter_indices)
    fig, axes = plt.subplots(1, n, figsize=(20, 3))
    fig.suptitle(f"Frequency Response (FFT) - {layer_name}", fontsize=13)

    for i, idx in enumerate(filter_indices):
        filt = weights[idx].mean(axis=0)   # 3×3 array

        # Pad to 64×64 for better frequency visualisation
        padded = np.pad(filt, ((30, 31), (30, 31)), mode="constant")

        # 2D FFT → shift zero-frequency to center → log magnitude
        freq = np.fft.fft2(padded)
        freq_shifted = np.fft.fftshift(freq)
        magnitude = np.log(np.abs(freq_shifted) + 1e-8)   # log scale

        axes[i].imshow(magnitude, cmap="hot")
        axes[i].set_title(f"Filter {idx}")
        axes[i].axis("off")

    plt.tight_layout()
    plt.savefig(f"Lab2_{layer_name}_FrequencyResponse.png", dpi=150)
    plt.show()
    print("Frequency response plots saved.")

display_frequency_response(conv_layers[0], selected_filter_indices)


