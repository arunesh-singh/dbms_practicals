import torch
import torchvision.models as models
import numpy as np
import matplotlib.pyplot as plt

# ---------------------------------------------------------------
# PART 1 (Study Notes): VGG Architecture Key Points
# ---------------------------------------------------------------
# i.   Filter Size: ALL convolution layers use 3x3 filters (small!)
#      This keeps parameters low while still capturing features.
#      Number of filters doubles at each stack: 64→128→256→512→512
#
# ii.  Parameters per filter response at one point:
#      For a 3x3 conv with C input channels:
#      Parameters = 3 × 3 × C + 1 (bias) = 9C + 1
#      Example: Layer 1 (3 input channels): 9×3+1 = 28 parameters
#      Example: Layer 3 (64 channels):      9×64+1 = 577 parameters
#
# iii. Effect of depth (more conv layers per stack):
#      - Deeper stacks can represent more complex patterns
#      - Two 3×3 convs have same receptive field as one 5×5 conv
#        but with fewer parameters (2×9C vs 25C)
#      - Deeper = better feature abstraction
#
# iv.  Changing activation function (ReLU → others):
#      - ReLU: fast, no vanishing gradient → used in VGG
#      - Sigmoid/Tanh: vanishing gradient in deep nets → worse
#      - LeakyReLU: fixes "dying ReLU" problem → slight improvement
#      - ReLU remains best choice for VGG-style deep nets

# ---------------------------------------------------------------
# PART 2: Load Pre-trained VGG16 and Analyse Filters
# ---------------------------------------------------------------

# Load VGG16 with ImageNet pre-trained weights
print("Loading pre-trained VGG16 ...")
model = models.vgg16(weights=models.VGG16_Weights.IMAGENET1K_V1)
model.eval()   # set to evaluation mode (no dropout/batchnorm changes)
print("Model loaded.\n")

# Print full architecture to understand layer names
print("VGG16 Architecture:")
print(model.features)   # only convolutional part

# Collect all conv layers from the model
conv_layers = []
for layer in model.features:
    if isinstance(layer, torch.nn.Conv2d):
        conv_layers.append(layer)

print(f"\nTotal Conv Layers in VGG16: {len(conv_layers)}")
for i, layer in enumerate(conv_layers):
    print(f"  Layer {i+1}: in_channels={layer.in_channels}, "
          f"out_channels={layer.out_channels}, kernel={layer.kernel_size}")


# ---------------------------------------------------------------
# TASK (i): Display filter coefficients of 8 random filters
#           from Stack 1 (first two conv layers: conv1_1, conv1_2)
# ---------------------------------------------------------------

def display_filter_coefficients(conv_layer, layer_name, n_filters=8):
    """
    Displays the weight (coefficient) values of n_filters randomly
    selected filters from a given conv layer.
    """
    weights = conv_layer.weight.data.cpu().numpy()
    # weights shape: (out_channels, in_channels, height, width)

    total_filters = weights.shape[0]
    selected_idx = np.random.choice(total_filters, n_filters, replace=False)
    print(f"\n{layer_name}: Showing {n_filters} random filters "
          f"(indices: {selected_idx})")

    fig, axes = plt.subplots(1, n_filters, figsize=(20, 3))
    fig.suptitle(f"Filter Coefficients - {layer_name}", fontsize=13)

    for i, idx in enumerate(selected_idx):
        # For display: take mean across input channels → single 3×3 image
        filt = weights[idx].mean(axis=0)
        im = axes[i].imshow(filt, cmap="RdBu", vmin=-filt.max(), vmax=filt.max())
        axes[i].set_title(f"Filter {idx}")
        axes[i].axis("off")
        # Print numerical values
        print(f"  Filter {idx} coefficients:\n{np.round(filt, 3)}")

    plt.colorbar(im, ax=axes[-1], fraction=0.046)
    plt.tight_layout()
    plt.savefig(f"Lab2_{layer_name}_coefficients.png", dpi=150)
    plt.show()

    return selected_idx  # return so we can reuse same filters in next tasks


# Run on Stack 1, Layer 1 (conv1_1): 64 filters, 3×3, input=3ch (RGB)
selected_filter_indices = display_filter_coefficients(conv_layers[0], "Stack1_Conv1")


# ---------------------------------------------------------------
# TASK (ii): Display filter responses (feature maps)
#            Pass a sample image through the model and visualise
#            what each of the 8 selected filters "sees"
# ---------------------------------------------------------------

from torchvision import transforms
from PIL import Image

def get_feature_maps(image_path, model, layer_index=0, filter_indices=None):
    """
    Passes an image through the model up to a chosen conv layer,
    then shows the output (activation map) for selected filters.
    """
    # --- Preprocess image (VGG expects 224×224, normalised) ---
    transform = transforms.Compose([
        transforms.Resize((224, 224)),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406],
                             std=[0.229, 0.224, 0.225])
    ])
    img = Image.open(image_path).convert("RGB")
    input_tensor = transform(img).unsqueeze(0)   # add batch dimension

    # --- Hook: capture output of chosen layer automatically ---
    activation = {}
    def hook_fn(module, input, output):
        activation["output"] = output.detach()

    hook = model.features[layer_index].register_forward_hook(hook_fn)
    with torch.no_grad():
        model(input_tensor)
    hook.remove()

    feature_maps = activation["output"].squeeze(0).numpy()
    # feature_maps shape: (num_filters, H, W)

    # --- Display feature maps for selected filters ---
    n = len(filter_indices)
    fig, axes = plt.subplots(1, n, figsize=(20, 3))
    fig.suptitle(f"Feature Maps at Layer {layer_index+1} (Conv Stack 1)", fontsize=13)

    for i, idx in enumerate(filter_indices):
        fmap = feature_maps[idx]
        axes[i].imshow(fmap, cmap="viridis")
        axes[i].set_title(f"Filter {idx}")
        axes[i].axis("off")

    plt.tight_layout()
    plt.savefig(f"Lab2_FeatureMaps_Layer{layer_index+1}.png", dpi=150)
    plt.show()
    print("Feature maps saved.")

