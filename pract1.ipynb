import os
import numpy as np
import matplotlib.pyplot as plt
from skimage import io, color, segmentation, filters, measure
from skimage.segmentation import slic, felzenszwalb, mark_boundaries
from skimage.feature import canny
import cv2

# ---------------------------------------------------------------
# PART 1: Dataset Exploration (CUB-200-2011)
# ---------------------------------------------------------------
# Download link: https://www.vision.caltech.edu/datasets/cub_200_2011/
# After downloading, set the path below:

DATASET_PATH = "./CUB_200_2011"   # <-- change this to your folder path

def explore_dataset(dataset_path):
    """
    Explores the CUB-200-2011 dataset structure and prints key stats.
    """
    print("=" * 50)
    print("CUB-200-2011 Dataset Exploration")
    print("=" * 50)

    # Read class names (200 bird species)
    classes_file = os.path.join(dataset_path, "classes.txt")
    with open(classes_file, "r") as f:
        classes = f.readlines()
    print(f"Total Classes (Bird Species): {len(classes)}")
    print("First 5 classes:")
    for c in classes[:5]:
        print("  ", c.strip())

    # Read image list
    images_file = os.path.join(dataset_path, "images.txt")
    with open(images_file, "r") as f:
        images = f.readlines()
    print(f"\nTotal Images: {len(images)}")

    # Read train/test split
    split_file = os.path.join(dataset_path, "train_test_split.txt")
    with open(split_file, "r") as f:
        split = f.readlines()
    train_count = sum(1 for line in split if line.strip().endswith("1"))
    test_count  = sum(1 for line in split if line.strip().endswith("0"))
    print(f"Training Images : {train_count}")
    print(f"Testing  Images : {test_count}")

# Uncomment the line below once dataset is downloaded:
# explore_dataset(DATASET_PATH)


# ---------------------------------------------------------------
# PART 2: Segmentation Algorithms + Distance Metrics
# ---------------------------------------------------------------

def run_segmentation(image_path):
    """
    Applies three segmentation algorithms on an image and
    computes distance metrics between segments.
    """
    # --- Load image ---
    image = io.imread(image_path)
    if image.ndim == 2:                        # if grayscale, convert to RGB
        image = color.gray2rgb(image)
    image = image[:, :, :3]                    # drop alpha channel if present

    print("\nImage shape:", image.shape)

    # ---- Method 1: SLIC (Simple Linear Iterative Clustering) ----
    # Groups pixels into superpixels based on color + spatial proximity
    slic_segments = slic(image, n_segments=100, compactness=10, start_label=1)

    # ---- Method 2: Felzenszwalb's Graph-Based Segmentation ----
    # Uses graph theory; good at preserving natural boundaries
    felzen_segments = felzenszwalb(image, scale=100, sigma=0.5, min_size=50)

    # ---- Method 3: Otsu Thresholding (Binary Segmentation) ----
    # Converts to grayscale, finds automatic threshold
    gray  = color.rgb2gray(image)
    thresh = filters.threshold_otsu(gray)       # automatic threshold value
    otsu_segments = gray > thresh               # True = foreground, False = background

    # --- Plot all three results ---
    fig, axes = plt.subplots(1, 4, figsize=(18, 4))
    axes[0].imshow(image);                                        axes[0].set_title("Original")
    axes[1].imshow(mark_boundaries(image, slic_segments));        axes[1].set_title("SLIC")
    axes[2].imshow(mark_boundaries(image, felzen_segments));      axes[2].set_title("Felzenszwalb")
    axes[3].imshow(otsu_segments, cmap="gray");                   axes[3].set_title("Otsu Threshold")
    for ax in axes: ax.axis("off")
    plt.tight_layout()
    plt.savefig("Lab1_Segmentation_Results.png", dpi=150)
    plt.show()
    print("Segmentation results saved.")

    # ---- Distance Metrics between Segmented Regions ----
    compute_distance_metrics(gray, slic_segments)


def compute_distance_metrics(gray_image, segments):
    """
    Computes Euclidean, Manhattan, and Hausdorff distances
    between the first two segment regions.
    """
    print("\n--- Distance Metrics Between Segments ---")

    # Get coordinates (pixel positions) of region 1 and region 2
    region1_coords = np.argwhere(segments == 1)   # pixels belonging to segment 1
    region2_coords = np.argwhere(segments == 2)   # pixels belonging to segment 2

    # Use centroid (mean position) for Euclidean and Manhattan
    c1 = region1_coords.mean(axis=0)   # centroid of region 1
    c2 = region2_coords.mean(axis=0)   # centroid of region 2

    # 1. Euclidean Distance: straight-line distance between centroids
    euclidean = np.sqrt(np.sum((c1 - c2) ** 2))
    print(f"Euclidean Distance  : {euclidean:.2f} pixels")

    # 2. Manhattan Distance: sum of absolute differences (city-block distance)
    manhattan = np.sum(np.abs(c1 - c2))
    print(f"Manhattan Distance  : {manhattan:.2f} pixels")

    # 3. Hausdorff Distance: maximum of minimum distances between two sets
    #    Uses a small subset for speed (full set can be slow)
    subset1 = region1_coords[:50]
    subset2 = region2_coords[:50]
    hausdorff = max(
        max(min(np.linalg.norm(p - q) for q in subset2) for p in subset1),
        max(min(np.linalg.norm(q - p) for p in subset1) for q in subset2)
    )
    print(f"Hausdorff Distance  : {hausdorff:.2f} pixels")

    # 4. Intensity difference between segments (mean pixel value)
    mean1 = gray_image[segments == 1].mean()
    mean2 = gray_image[segments == 2].mean()
    print(f"Mean Intensity - Seg1: {mean1:.3f},  Seg2: {mean2:.3f}")
    print(f"Intensity Difference : {abs(mean1 - mean2):.3f}")


# ---------------------------------------------------------------
# PART 3: Edge Detection Algorithms
# ---------------------------------------------------------------

def run_edge_detection(image_path):
    """
    Applies Sobel, Prewitt, and Canny edge detectors.
    Goal: better edge localisation + fewer false edges.
    """
    image = io.imread(image_path)
    if image.ndim == 3:
        gray = color.rgb2gray(image)
    else:
        gray = image.astype(float) / 255.0

    # ---- 1. Sobel Edge Detector ----
    # Computes gradient in X and Y direction, then combines them
    sobel_edges = filters.sobel(gray)

    # ---- 2. Prewitt Edge Detector ----
    # Similar to Sobel but with uniform weights (slightly less noise-resistant)
    prewitt_edges = filters.prewitt(gray)

    # ---- 3. Canny Edge Detector (Best for fewer false edges) ----
    # - Applies Gaussian smoothing first (reduces noise)
    # - Finds gradient magnitude and direction
    # - Uses hysteresis thresholding to keep only strong, connected edges
    canny_edges = canny(gray, sigma=2.0, low_threshold=0.1, high_threshold=0.2)
    # sigma=2.0 → more smoothing → fewer false edges
    # low/high_threshold → controls which edges are kept

    # ---- 4. Laplacian of Gaussian (LoG) using OpenCV ----
    # Highlights regions of rapid intensity change
    gray_uint8  = (gray * 255).astype(np.uint8)
    blurred     = cv2.GaussianBlur(gray_uint8, (5, 5), 0)   # smooth first
    log_edges   = cv2.Laplacian(blurred, cv2.CV_64F)
    log_edges   = np.abs(log_edges)

    # --- Plot results ---
    fig, axes = plt.subplots(1, 5, figsize=(22, 4))
    axes[0].imshow(gray,         cmap="gray"); axes[0].set_title("Original (Gray)")
    axes[1].imshow(sobel_edges,  cmap="gray"); axes[1].set_title("Sobel")
    axes[2].imshow(prewitt_edges,cmap="gray"); axes[2].set_title("Prewitt")
    axes[3].imshow(canny_edges,  cmap="gray"); axes[3].set_title("Canny (Best)\nsigma=2.0")
    axes[4].imshow(log_edges,    cmap="gray"); axes[4].set_title("LoG (OpenCV)")
    for ax in axes: ax.axis("off")
    plt.tight_layout()
    plt.savefig("Lab1_EdgeDetection_Results.png", dpi=150)
    plt.show()
    print("Edge detection results saved.")

    # Summary comparison
    print("\n--- Edge Detection Summary ---")
    print(f"Sobel   edge pixels : {np.sum(sobel_edges   > 0.1)}")
    print(f"Prewitt edge pixels : {np.sum(prewitt_edges > 0.1)}")
    print(f"Canny   edge pixels : {np.sum(canny_edges)}")
    print("Canny gives the best localisation with fewest false edges.")


# ---------------------------------------------------------------
# MAIN - Run everything
# ---------------------------------------------------------------
if __name__ == "__main__":
    # Replace with any image path from CUB dataset or any local image
    IMAGE_PATH = "sample_bird.jpg"   # <-- put your image path here

    print("\n>>> Running Segmentation ...")
    run_segmentation(IMAGE_PATH)

    print("\n>>> Running Edge Detection ...")
    run_edge_detection(IMAGE_PATH)
